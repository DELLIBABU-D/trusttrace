# TrustTrace settings. Copy this file to ".env" (same folder as serve.py) and change what you need.
# Every setting is optional: with no .env the app runs with safe local defaults.
# Real environment variables override this file. Never commit your real .env.

# Web server port (open http://localhost:PORT)
PORT=5173

# HOST=0.0.0.0 lets other laptops/phones on the same Wi-Fi open the site (default: this laptop only)
# HOST=0.0.0.0

# Where the database, uploads and generated keys live (default: backend/data)
# TT_DATA_DIR=backend/data

# Use PostgreSQL instead of SQLite (optional; SQLite is fine for the demo)
# TT_DATABASE_URL=postgresql+psycopg://user:password@localhost/trusttrace

# Keys. If unset, random keys are generated ONCE into the data folder (secret.key, evidence.key,
# passport_ed25519.pem). Back that folder up: losing evidence.key makes old chain entries unverifiable,
# losing passport_ed25519.pem invalidates issued passports.
# TT_SECRET_KEY=change-me-to-a-long-random-string
# TT_EVIDENCE_KEY=another-long-random-string
# TT_PASSPORT_KEY_FILE=C:\path\to\passport_ed25519.pem

# Demo only: approve new recruiter organisations immediately (normally: python backend/manage.py approve-org EMAIL)
# TT_AUTO_APPROVE_ORGS=1

# Public address printed in passport QR codes (e.g. when demoing from another device on the network)
# TT_PUBLIC_URL=http://192.168.1.20:5173
# TT_PASSPORT_TTL_DAYS=90

# Sessions and limits
# TT_TOKEN_TTL_HOURS=12
# TT_MAX_REQUEST_MB=12

# OCR: full path to tesseract.exe if it isn't on PATH (Windows)
# TT_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional Gemini assistance (question drafting, extraction gap filling). Paid/free-tier Google API key, server-side only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Override scoring weights / pattern thresholds (JSON). See backend/app/fraud/config.py.
# TT_FRAUD_CONFIG={"patterns": {"rapid_applications": {"count": 5, "window_minutes": 10}}}

# DigiLocker comparison. With no credentials a clearly-labelled SIMULATED DigiLocker is used (never counted).
# Real DigiLocker needs an approved Requester app from the DigiLocker Partner Portal.
# TT_DIGILOCKER_MODE=simulated
# TT_DIGILOCKER_CLIENT_ID=
# TT_DIGILOCKER_CLIENT_SECRET=
# TT_DIGILOCKER_REDIRECT_URI=https://your-domain/api/digilocker/callback
